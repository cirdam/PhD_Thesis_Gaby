@article{PierreAuger:2021:InfillSpectrum,
  title = {The Energy Spectrum of Cosmic Rays beyond the Turn-down around {{eV}} as Measured with the Surface Detector of the {{Pierre Auger Observatory}}},
  author = {{The Pierre Auger Collaboration}},
  year = 2021,
  month = nov,
  journal = {The European Physical Journal C},
  volume = {81},
  number = {11},
  pages = {966},
  publisher = {Springer Berlin Heidelberg},
  issn = {1434-6044, 1434-6052},
  doi = {10.1140/epjc/s10052-021-09700-w},
  urldate = {2024-10-28},
  abstract = {We present a measurement of the cosmic-ray spectrum above 100 PeV using the part of the surface detector of the Pierre Auger Observatory that has a spacing of 750 m. An inflection of the spectrum is observed, confirming the presence of the so-called \emph{second-knee{$<$}i/{$>$} feature. The spectrum is then combined with that of the 1500 m array to produce a single measurement of the flux, linking this spectral feature with the three additional breaks at the highest energies. The combined spectrum, with an energy scale set calorimetrically via fluorescence telescopes and using a single detector type, results in the most statistically and systematically precise measurement of spectral breaks yet obtained. These measurements are critical for furthering our understanding of the highest energy cosmic rays.}},
  copyright = {\copyright{} The Author(s) 2021},
  langid = {english},
  keywords = {Auger,SD Spectrum,SD1500,Unfolding},
  file = {/home/pbrichetto/bwSyncShare/Zotero/storage/EC2PTYEJ/Abreu et al. - 2021 - The energy spectrum of cosmic rays beyond the turn-down around eV as measured with the surface detec.pdf;/home/pbrichetto/bwSyncShare/Zotero/storage/CJBMVKJ8/10052_2021_Article_9700.html}
}

