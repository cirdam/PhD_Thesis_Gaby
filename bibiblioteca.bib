@techreport{GAP:Gonzalez:2020:Geometry,
  type = {{{GAP Note}}},
  title = {Accuracy of the Event Geometry Reconstruction with the {{SD-433}}},
  author = {Gonz{\'a}lez, N and Ravignani, D and Melo, D and Roncoroni, M and Silli, G},
  year = 2020,
  number = {GAP2020-038},
  institution = {Pierre Auger},
  abstract = {The SD-433 is the low-energy extension of the surface detector. It is composed by 19 waterCherenkov detectors separated by 433 m deployed around the station Tina Turner (id 1764). The array has been operational since January 2013. In view of the current efforts to expand the AugerPrime photon search programme down to {$\sim$} 1016 eV, we report an in-depth analysis of the air-shower core position and angular resolutions of the SD-433 with real data. The dependence of these magnitudes on the event multiplicity, impact point, primary energy and zenith angle are discussed. After applying Monte-Carlo-based trigger efficiency quality cuts in the primary energy-zenith phase space and assuming a pure-proton composition, the core position and angular resolutions reach 30 m and 2.3\textopenbullet{} at the full-efficiency energy threshold of 1.3 \texttimes{} 1016 eV. The resolutions improve significantly with the primary energy, for instance being 23 m and 1.4\textopenbullet{} when restricting the event selection to E {$>$} 3 {$\cdot$} 1016 eV and \texttheta{} {$<$} 45\textopenbullet.},
  langid = {english},
  file = {/home/pbrichetto/bwSyncShare/Zotero/storage/XNF92YAT/González et al. - 2020 - Accuracy of the event geometry reconstruction with the SD-433.pdf}
}

@techreport{GAP:Gonzalez:2022:Exposure,
  type = {{{GAP Note}}},
  title = {The Exposure of the 433 m Array},
  author = {Gonz{\'a}lez, Nicol{\'a}s M and Bonifazi, Carla and Mari{\c s}, Ioana C},
  year = 2022,
  number = {GAP2022-041},
  institution = {Pierre Auger Collaboration},
  abstract = {The 433 m array (SD-433) is composed of 19 stations arranged in seven hexagons. A single station with an erratic performance may decrease the 6T5 acceptance between 17\% and 100\%, thus hampering a precise measurement of the cosmic-ray flux. In this note, we apply the official method to search for periods of unstable data acquisition with the SD-433. We scan the data acquired during four years of operation between 1st January 2018 and 31st March 2022. Those so-called bad periods span 39 out of the 221 analyzed weeks, representing {$\sim$} 18\% of the total running time of the array. The accumulated exposure of the SD-433 after excluding such periods is (6.15 \textpm{} 0.25) km2 yr sr, which can be reached with seven hexagons with ideal uptime in 2.77 years.},
  langid = {english},
  file = {/home/pbrichetto/bwSyncShare/Zotero/storage/Y92NDR42/González et al. - 2022 - The exposure of the 433 m array.pdf}
}

@techreport{GAP:Rodriguez:2024:Efficiency,
  type = {{{GAP Note}}},
  title = {Revisiting the {{SD-433}} Efficiency},
  author = {Rodriguez, Ezequiel and Orquera, Gabriel Brichetto and Gonz{\'a}lez, Nicolas and Ravignani, Diego and Roth, Markus and Schmidt, David and Veberi{\v c}, Darko and Wundheiler, Brian},
  year = 2024,
  number = {GAP2024-051},
  institution = {Pierre Auger},
  abstract = {The trigger efficiency of the SD-433 array is examined using simulations and validated with measured data. An analytical model valid in a wide range of energy, zenith angle, and primary mass is fitted with simulations on the Monte-Carlo energy scale. The derived efficiency is corrected a posteriori to match the SD-433 energy scale. The model is validated using measured data by testing for isotropy of arrival directions. To better understand the position of the second knee, the findings suggest that using lg(E/eV) = 16.8 as the initial point for measuring the cosmic-ray spectrum with SD-433 is both conservative and secure.},
  langid = {english},
  file = {/home/pbrichetto/bwSyncShare/Zotero/storage/Z62FZ7H4/Rodriguez et al. - 2024 - Revisiting the SD-433 efficiency.pdf}
}

