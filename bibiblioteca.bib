  doi = {10.1016/j.nima.2009.11.018},
  urldate = {2026-04-10},
  abstract = {The surface detector array of the Pierre Auger Observatory consists of 1600 water-Cherenkov detectors, for the study of extensive air showers (EAS) generated by ultra-high-energy cosmic rays. We describe the trigger hierarchy, from the identification of candidate showers at the level of a single detector, amongst a large background (mainly random single cosmic ray muons), up to the selection of real events and the rejection of random coincidences. Such trigger makes the surface detector array fully efficient for the detection of EAS with energy above \$3\textbackslash times 10\textasciicircum\textbraceleft 18\textbraceright\$ eV, for all zenith angles between 0\$\textasciicircum\textbackslash circ\$ and 60\$\textasciicircum\textbackslash circ\$, independently of the position of the impact point and of the mass of the primary particle. In these range of energies and angles, the exposure of the surface array can be determined purely on the basis of the geometrical acceptance.},
